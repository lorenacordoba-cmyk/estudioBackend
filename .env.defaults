# Configuración no secreta del backend. Los valores de .env tienen prioridad.
PORT=3001
NODE_ENV=development
FRONTEND_ORIGIN=http://localhost:4200
LOG_LEVEL=info
TRUST_PROXY_HOPS=0

# GroqCloud
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_OUTPUT_MODE=auto
GROQ_MODEL=openai/gpt-oss-20b
GROQ_LEGAL_REVIEW_MODEL=openai/gpt-oss-20b
GROQ_TRIAGE_OUTPUT_MODE=json_object
GROQ_REASONING_EFFORT=low
GROQ_MAX_COMPLETION_TOKENS=900
GROQ_LEGAL_REVIEW_REASONING_EFFORT=medium
GROQ_LEGAL_REVIEW_MAX_COMPLETION_TOKENS=2000
GROQ_TPM_TARGET=6500
GROQ_RPM_TARGET=25
GROQ_GUARD_TPM_TARGET=12000
GROQ_GUARD_RPM_TARGET=25
GROQ_RATE_MAX_WAIT_MS=90000
GROQ_RATE_MAX_RETRIES=3
GROQ_RATE_MAX_QUEUE=10
GROQ_TIMEOUT_MS=45000
GROQ_GUARD_ENABLED=true
GROQ_GUARD_THRESHOLD=0.5
GROQ_GUARD_MODEL=meta-llama/llama-prompt-guard-2-22m
GROQ_DAILY_BUDGET_USD=15
GROQ_DAILY_REQUEST_LIMIT=1000
GROQ_DAILY_TOKEN_LIMIT=2000000
GROQ_INPUT_USD_PER_1M=0.075
GROQ_CACHED_INPUT_USD_PER_1M=0.037
GROQ_OUTPUT_USD_PER_1M=0.30
GROQ_GUARD_USD_PER_1M=0.03

# Cloudflare Turnstile
TURNSTILE_ENABLED=false
TURNSTILE_EXPECTED_HOSTNAME=
TURNSTILE_EXPECTED_ACTION=legal_triage_session
TURNSTILE_CONTACT_ACTION=legal_contact_form

# Límites y comportamiento de seguridad
SESSION_TTL_HOURS=24
MAX_SESSION_ATTEMPTS_PER_IP_MINUTE=20
MAX_CONTACT_ATTEMPTS_PER_IP_MINUTE=10
MAX_CONTACT_PER_IP_HOUR=5
MAX_CONTACT_PER_IP_DAY=15
MAX_SESSIONS_PER_IP_HOUR=5
MAX_SESSIONS_PER_IP_DAY=15
MAX_CHAT_PER_IP_MINUTE=10
MAX_MESSAGES_PER_SESSION_HOUR=30
MAX_MESSAGES_PER_SESSION_TOTAL=60
ABUSE_BLOCK_MINUTES=60
MAX_CONCURRENT_PER_SESSION=1
MAX_GLOBAL_GROQ_CONCURRENT=8
MESSAGE_MAX_CHARS=3000

# Estudio y correo
STUDY_NAME=Estudio Jurídico Lorena Córdoba
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_FROM=Lorena Córdoba<notificaciones@estudiojuridicobsas.com.ar>
DELIVERY_RETRY_MAX=3
DELIVERY_RETRY_DELAY_MS=5000
MAX_ACTIVE_SESSIONS=10
